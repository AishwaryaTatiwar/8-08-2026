@model AirlineMgmtSystem.User

@{
    ViewBag.Title = "Edit User Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Edit User Role</h3>
        </div>

        <div class="card-body">

            @using (Html.BeginForm("EditUser", "Admin", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.Hidden("UserID", Model.UserID)

                <!-- Username -->
                <div class="mb-3">
                    <label class="form-label">Username</label>

                    @Html.TextBoxFor(
                        model => model.Username,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        }
                    )
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label class="form-label">Email</label>

                    @Html.TextBoxFor(
                        model => model.Email,
                        new
                        {
                            @class = "form-control",
                            @readonly = "readonly"
                        }
                    )
                </div>

                <!-- Role -->
                <div class="mb-3">
                    <label class="form-label">Role</label>

                    @Html.DropDownListFor(
                        model => model.Role,
                        new SelectList(
                            new[]
                            {
                                "Customer",
                                "Admin"
                            },
                            Model.Role
                        ),
                        "-- Select Role --",
                        new
                        {
                            @class = "form-select"
                        }
                    )
                </div>

                <!-- Buttons -->
                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-success">
                        <i class="bi bi-check-circle"></i>
                        Save Changes
                    </button>

                    <a href="@Url.Action("ManageUsers", "Admin")"
                       class="btn btn-secondary ms-2">
                        <i class="bi bi-arrow-left"></i>
                        Cancel
                    </a>

                </div>
            }

        </div>

    </div>

</div>
@model AirlineMgmtSystem.User

@{
    ViewBag.Title = "Edit User Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Edit User Role</h3>
        </div>

        <div class="card-body">

            <form action="@Url.Action("EditUser", "Admin")"
                  method="post">

                <input type="hidden"
                       name="UserID"
                       value="@Model.UserID" />

                <div class="mb-3">
                    <label class="form-label">Username</label>

                    <input type="text"
                           class="form-control"
                           value="@Model.Username"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>

                    <input type="text"
                           class="form-control"
                           value="@Model.Email"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Role</label>

                    <select name="Role"
                            class="form-control">

                        <option value="Customer"
                                @(Model.Role == "Customer" ? "selected" : "")>
                            Customer
                        </option>

                        <option value="Admin"
                                @(Model.Role == "Admin" ? "selected" : "")>
                            Admin
                        </option>

                    </select>
                </div>

                <button type="submit"
                        class="btn btn-success">
                    Save Changes
                </button>

                <a href="@Url.Action("ManageUsers", "Admin")"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>
[HttpGet]
public ActionResult EditUser(int id)
{
    var user = db.Users.FirstOrDefault(x => x.UserID == id);

    if (user == null)
        return HttpNotFound();

    return View(user);
}
