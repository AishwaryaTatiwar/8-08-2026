@model AirlineMgmtSystem.ViewModels.PassengerDetailsViewModel

@{
    ViewBag.Title = "Passenger Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3>Passenger Details</h3>
        </div>

        <div class="card-body">

            <!-- Flight Information -->

            <div class="alert alert-info">

                <h4>
                    Flight: @Model.FlightNumber
                </h4>

                <p>
                    <strong>From:</strong>
                    @Model.Source

                    &nbsp;&nbsp;

                    <strong>To:</strong>
                    @Model.Destination
                </p>

                <p>
                    <strong>Fare per passenger:</strong>
                    ₹@Model.Price
                </p>

            </div>

            @using (Html.BeginForm(
                "PassengerDetails",
                "Booking",
                FormMethod.Post,
                new { id = "passengerForm" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.FlightID)

                <div id="passengerContainer">

                    @for (int i = 0; i < Model.Passengers.Count; i++)
                    {
                        <div class="card mb-3 passenger-card">

                            <div class="card-header">
                                <strong>
                                    Passenger @(i + 1)
                                </strong>
                            </div>

                            <div class="card-body">

                                <div class="row">

                                    <!-- Passenger Name -->

                                    <div class="col-md-4">

                                        <div class="form-group">

                                            <label>
                                                Passenger Name
                                            </label>

                                            <input type="text"
                                                   name="Passengers[@i].PassengerName"
                                                   class="form-control"
                                                   value="@Model.Passengers[i].PassengerName"
                                                   placeholder="Enter full name"
                                                   required />

                                        </div>

                                    </div>

                                    <!-- Passenger Age -->

                                    <div class="col-md-3">

                                        <div class="form-group">

                                            <label>
                                                Age
                                            </label>

                                            <input type="number"
                                                   name="Passengers[@i].PassengerAge"
                                                   class="form-control"
                                                   value="@Model.Passengers[i].PassengerAge"
                                                   min="1"
                                                   max="120"
                                                   required />

                                        </div>

                                    </div>

                                    <!-- Passenger Gender -->

                                    <div class="col-md-3">

                                        <div class="form-group">

                                            <label>
                                                Gender
                                            </label>

                                            <select name="Passengers[@i].PassengerGender"
                                                    class="form-control"
                                                    required>

                                                <option value="">
                                                    Select Gender
                                                </option>

                                                <option value="Male"
                                                        @(Model.Passengers[i].PassengerGender == "Male"
                                                            ? "selected"
                                                            : "")>
                                                    Male
                                                </option>

                                                <option value="Female"
                                                        @(Model.Passengers[i].PassengerGender == "Female"
                                                            ? "selected"
                                                            : "")>
                                                    Female
                                                </option>

                                                <option value="Other"
                                                        @(Model.Passengers[i].PassengerGender == "Other"
                                                            ? "selected"
                                                            : "")>
                                                    Other
                                                </option>

                                            </select>

                                        </div>

                                    </div>

                                    <!-- Remove button -->

                                    <div class="col-md-2">

                                        <label>&nbsp;</label>

                                        <button type="button"
                                                class="btn btn-danger form-control removePassenger">
                                            Remove
                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div class="mt-3">

                    <button type="button"
                            id="addPassenger"
                            class="btn btn-secondary">
                        + Add Passenger
                    </button>

                </div>

                <hr />

                <div class="text-right">

                    <button type="submit"
                            class="btn btn-primary btn-lg">
                        Continue to Seat Selection
                    </button>

                </div>
            }

        </div>

    </div>

</div>


<script>

    var passengerIndex =
        document.querySelectorAll(".passenger-card").length;


    // Add passenger

    document.getElementById("addPassenger")
        .addEventListener("click", function () {

            var container =
                document.getElementById("passengerContainer");

            var html = `
                <div class="card mb-3 passenger-card">

                    <div class="card-header">
                        <strong>
                            Passenger ${passengerIndex + 1}
                        </strong>
                    </div>

                    <div class="card-body">

                        <div class="row">

                            <div class="col-md-4">

                                <div class="form-group">

                                    <label>
                                        Passenger Name
                                    </label>

                                    <input type="text"
                                           name="Passengers[${passengerIndex}].PassengerName"
                                           class="form-control"
                                           placeholder="Enter full name"
                                           required />

                                </div>

                            </div>


                            <div class="col-md-3">

                                <div class="form-group">

                                    <label>
                                        Age
                                    </label>

                                    <input type="number"
                                           name="Passengers[${passengerIndex}].PassengerAge"
                                           class="form-control"
                                           min="1"
                                           max="120"
                                           required />

                                </div>

                            </div>


                            <div class="col-md-3">

                                <div class="form-group">

                                    <label>
                                        Gender
                                    </label>

                                    <select name="Passengers[${passengerIndex}].PassengerGender"
                                            class="form-control"
                                            required>

                                        <option value="">
                                            Select Gender
                                        </option>

                                        <option value="Male">
                                            Male
                                        </option>

                                        <option value="Female">
                                            Female
                                        </option>

                                        <option value="Other">
                                            Other
                                        </option>

                                    </select>

                                </div>

                            </div>


                            <div class="col-md-2">

                                <label>&nbsp;</label>

                                <button type="button"
                                        class="btn btn-danger form-control removePassenger">
                                    Remove
                                </button>

                            </div>

                        </div>

                    </div>

                </div>
            `;

            container.insertAdjacentHTML("beforeend", html);

            passengerIndex++;

        });


    // Remove passenger

    document.getElementById("passengerContainer")
        .addEventListener("click", function (e) {

            if (e.target.classList.contains("removePassenger")) {

                var cards =
                    document.querySelectorAll(".passenger-card");

                if (cards.length <= 1) {

                    alert("At least one passenger is required.");

                    return;
                }

                e.target
                    .closest(".passenger-card")
                    .remove();

            }

        });

</script>
