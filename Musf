@model IEnumerable<AirlineMgmtSystem.User>

@{
    ViewBag.Title = "Manage Users";
}

<div class="container mt-4">

    <h2 class="mb-4">
        <i class="bi bi-people-fill"></i> Manage Users
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow">
        <div class="card-body">

            <!-- Search -->
            <form method="get" action="@Url.Action("ManageUsers", "Admin")"
                  class="d-flex mb-3">

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control me-2"
                       placeholder="Search username..." />

                <input type="hidden"
                       name="pageSize"
                       value="@ViewBag.PageSize" />

                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                <a href="@Url.Action("ManageUsers", "Admin",
                    new { page = 1, pageSize = ViewBag.PageSize })"
                   class="btn btn-secondary ms-2">
                    Clear
                </a>
            </form>


            <!-- Page size -->
            <div class="mb-3">
                Show
                <select class="form-select d-inline-block w-auto"
                        onchange="location.href=this.value">

                    <option value="@Url.Action("ManageUsers", new { page = 1, pageSize = 5, search = ViewBag.Search })"
                            @(ViewBag.PageSize == 5 ? "selected" : "")>5</option>

                    <option value="@Url.Action("ManageUsers", new { page = 1, pageSize = 10, search = ViewBag.Search })"
                            @(ViewBag.PageSize == 10 ? "selected" : "")>10</option>

                    <option value="@Url.Action("ManageUsers", new { page = 1, pageSize = 20, search = ViewBag.Search })"
                            @(ViewBag.PageSize == 20 ? "selected" : "")>20</option>

                </select>
                entries
            </div>


            <!-- Users table -->
            <div class="table-responsive">
                <table class="table table-bordered table-hover">

                    <thead class="table-primary">
                        <tr>
                            <th>User ID</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Created On</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.UserID</td>
                                    <td>@item.Username</td>
                                    <td>@item.Email</td>
                                    <td>@item.Role</td>
                                    <td>@item.CreatedAt.ToString("dd-MM-yyyy HH:mm")</td>

                                    <td>
                                        <button type="button"
                                                class="btn btn-warning btn-sm edit-user"
                                                data-id="@item.UserID">
                                            Edit Role
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-danger">
                                    No Users Found
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>


            <!-- Pagination -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">

                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   href="@Url.Action("ManageUsers", new {
                                       page = ViewBag.CurrentPage - 1,
                                       pageSize = ViewBag.PageSize,
                                       search = ViewBag.Search
                                   })">
                                    Previous
                                </a>
                            </li>
                        }

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   href="@Url.Action("ManageUsers", new {
                                       page = i,
                                       pageSize = ViewBag.PageSize,
                                       search = ViewBag.Search
                                   })">
                                    @i
                                </a>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   href="@Url.Action("ManageUsers", new {
                                       page = ViewBag.CurrentPage + 1,
                                       pageSize = ViewBag.PageSize,
                                       search = ViewBag.Search
                                   })">
                                    Next
                                </a>
                            </li>
                        }

                    </ul>
                </nav>
            }

        </div>
    </div>
</div>


<!-- Edit User modal loaded here -->
<div id="editUserModal"></div>


<script>
    $(document).on("click", ".edit-user", function () {

        var id = $(this).data("id");

        $.get('@Url.Action("EditUser", "Admin")',
            { id: id },
            function (result) {

                $("#editUserModal").html(result);
                $("#editRoleModal").modal("show");

            });
    });
</script>
