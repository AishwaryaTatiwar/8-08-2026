@model IEnumerable<Airlinemgmtsystem.User>

@{
    ViewBag.Title = "Manage Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-people-fill"></i> Manage Users
        </h2>
    </div>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="card shadow">
        <div class="card-body">

            <!-- Search + Page Size -->
            <div class="row mb-3">

                <!-- Search -->
                <div class="col-md-6">
                    <form method="get"
                          action="@Url.Action("ManageUsers", "Admin")"
                          class="d-flex">

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control me-2"
                               placeholder="Search username..." />

                        <input type="hidden"
                               name="pageSize"
                               value="@ViewBag.PageSize" />

                        <button type="submit"
                                class="btn btn-primary">
                            Search
                        </button>

                        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                        {
                            <a href="@Url.Action("ManageUsers", "Admin", new { page = 1, pageSize = ViewBag.PageSize })"
                               class="btn btn-secondary ms-2">
                                Clear
                            </a>
                        }
                    </form>
                </div>

                <!-- Page Size -->
                <div class="col-md-6 text-md-end mt-2 mt-md-0">

                    <label class="me-2">Show</label>

                    <select class="form-select d-inline-block"
                            style="width:80px;"
                            onchange="changePageSize(this.value)">

                        <option value="5"
                                @(ViewBag.PageSize == 5 ? "selected" : "")>
                            5
                        </option>

                        <option value="10"
                                @(ViewBag.PageSize == 10 ? "selected" : "")>
                            10
                        </option>

                        <option value="20"
                                @(ViewBag.PageSize == 20 ? "selected" : "")>
                            20
                        </option>

                    </select>

                    <span class="ms-1">entries</span>

                </div>

            </div>


            <!-- Users Table -->
            <div class="table-responsive">

                <table class="table table-bordered table-hover table-striped align-middle">

                    <thead class="table-primary">
                        <tr>
                            <th>User ID</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Created On</th>
                            <th style="width:120px;">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.UserID)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.Username)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.Email)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.Role)
                                    </td>

                                    <td>
                                        @Html.DisplayFor(modelItem => item.CreatedAt)
                                    </td>

                                    <td>
                                        <button type="button"
                                                class="btn btn-warning btn-sm edit-user-btn"
                                                data-id="@item.UserID"
                                                data-username="@item.Username"
                                                data-role="@item.Role">

                                            <i class="bi bi-pencil-square"></i>
                                            Edit Role

                                        </button>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-danger">
                                    No Users Found
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- Server-Side Pagination -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">

                        <!-- Previous -->
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item">

                                <a class="page-link"
                                   href="@Url.Action("ManageUsers", "Admin", new {
                                       page = ViewBag.CurrentPage - 1,
                                       pageSize = ViewBag.PageSize,
                                       search = ViewBag.Search
                                   })">
                                    Previous
                                </a>

                            </li>
                        }


                        <!-- Page Numbers -->
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            if (i == ViewBag.CurrentPage)
                            {
                                <li class="page-item active">
                                    <span class="page-link">
                                        @i
                                    </span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">

                                    <a class="page-link"
                                       href="@Url.Action("ManageUsers", "Admin", new {
                                           page = i,
                                           pageSize = ViewBag.PageSize,
                                           search = ViewBag.Search
                                       })">
                                        @i
                                    </a>

                                </li>
                            }
                        }


                        <!-- Next -->
                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item">

                                <a class="page-link"
                                   href="@Url.Action("ManageUsers", "Admin", new {
                                       page = ViewBag.CurrentPage + 1,
                                       pageSize = ViewBag.PageSize,
                                       search = ViewBag.Search
                                   })">
                                    Next
                                </a>

                            </li>
                        }

                    </ul>
                </nav>
            }

        </div>
    </div>

</div>


<!-- ===================================================== -->
<!-- EDIT USER MODAL                                       -->
<!-- ===================================================== -->

<div id="editUserModal"
     class="modal fade"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header bg-primary text-white">

                <h5 class="modal-title">
                    Edit User Role
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <!-- EditUser partial will be loaded here -->

            </div>

        </div>

    </div>

</div>


<script>

    // =====================================================
    // CHANGE PAGE SIZE
    // =====================================================

    function changePageSize(pageSize) {

        var search = '@Html.Raw(HttpUtility.JavaScriptStringEncode(ViewBag.Search as string ?? ""))';

        window.location.href =
            '@Url.Action("ManageUsers", "Admin")'
            + '?page=1'
            + '&pageSize=' + pageSize
            + '&search=' + encodeURIComponent(search);
    }


    // =====================================================
    // EDIT USER - AJAX
    // =====================================================

    $(document).on("click", ".edit-user-btn", function () {

        var userId = $(this).data("id");

        $.ajax({

            url: '@Url.Action("EditUser", "Admin")',

            type: 'GET',

            data: {
                id: userId
            },

            success: function (data) {

                // Put EditUser partial inside modal
                $("#editUserModal .modal-body").html(data);

                // Explicitly open Bootstrap modal
                var modalElement =
                    document.getElementById("editUserModal");

                var modal =
                    bootstrap.Modal.getOrCreateInstance(modalElement);

                modal.show();
            },

            error: function () {

                alert("Unable to load user details.");

            }

        });

    });

</script>
