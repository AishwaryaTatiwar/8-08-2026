@model AirlineMgmtSystem.ViewModels.PassengerDetailsViewModel

@{
    ViewBag.Title = "Passenger Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- Flight Information -->
    <div class="card shadow mb-4">

        <div class="card-header bg-primary text-white">
            <h3>Flight Details</h3>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-3">
                    <strong>Flight Number</strong>
                    <p>@Model.FlightNumber</p>
                </div>

                <div class="col-md-3">
                    <strong>From</strong>
                    <p>@Model.Source</p>
                </div>

                <div class="col-md-3">
                    <strong>To</strong>
                    <p>@Model.Destination</p>
                </div>

                <div class="col-md-3">
                    <strong>Price / Passenger</strong>
                    <p>₹ @Model.Price</p>
                </div>

            </div>

        </div>

    </div>


    <!-- Passenger Details -->
    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <h3>
                Passenger Details
            </h3>

        </div>


        <div class="card-body">

            @using (Html.BeginForm(
                "PassengerDetails",
                "Booking",
                FormMethod.Post,
                new { id = "passengerForm" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(model => model.FlightID)


                <!-- Validation message -->

                if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">

                        @Html.ValidationSummary(
                            true,
                            "",
                            new { @class = "text-danger" })

                    </div>
                }


                <!-- Passenger container -->

                <div id="passengerContainer">

                    @if (Model.Passengers != null &&
                         Model.Passengers.Count > 0)
                    {
                        for (int i = 0;
                             i < Model.Passengers.Count;
                             i++)
                        {
                            <div class="card mb-3 passenger-card">

                                <div class="card-header">

                                    <strong>
                                        Passenger @(i + 1)
                                    </strong>

                                </div>


                                <div class="card-body">

                                    <div class="row">

                                        <!-- Name -->

                                        <div class="col-md-4">

                                            <div class="form-group">

                                                <label>
                                                    Passenger Name
                                                </label>

                                                <input type="text"
                                                       name="Passengers[@i].PassengerName"
                                                       value="@Model.Passengers[i].PassengerName"
                                                       class="form-control passenger-name"
                                                       placeholder="Enter passenger name"
                                                       required />

                                            </div>

                                        </div>


                                        <!-- Age -->

                                        <div class="col-md-3">

                                            <div class="form-group">

                                                <label>
                                                    Age
                                                </label>

                                                <input type="number"
                                                       name="Passengers[@i].PassengerAge"
                                                       value="@Model.Passengers[i].PassengerAge"
                                                       class="form-control passenger-age"
                                                       min="1"
                                                       max="120"
                                                       placeholder="Age"
                                                       required />

                                            </div>

                                        </div>


                                        <!-- Gender -->

                                        <div class="col-md-3">

                                            <div class="form-group">

                                                <label>
                                                    Gender
                                                </label>

                                                <select name="Passengers[@i].PassengerGender"
                                                        class="form-control passenger-gender"
                                                        required>

                                                    <option value="">
                                                        Select Gender
                                                    </option>

                                                    <option value="Male"
                                                        @(Model.Passengers[i].PassengerGender == "Male"
                                                            ? "selected"
                                                            : "")>
                                                        Male
                                                    </option>

                                                    <option value="Female"
                                                        @(Model.Passengers[i].PassengerGender == "Female"
                                                            ? "selected"
                                                            : "")>
                                                        Female
                                                    </option>

                                                    <option value="Other"
                                                        @(Model.Passengers[i].PassengerGender == "Other"
                                                            ? "selected"
                                                            : "")>
                                                        Other
                                                    </option>

                                                </select>

                                            </div>

                                        </div>


                                        <!-- Remove -->

                                        <div class="col-md-2">

                                            <div class="form-group">

                                                <label>
                                                    &nbsp;
                                                </label>

                                                <button type="button"
                                                        class="btn btn-danger form-control removePassenger">

                                                    Remove

                                                </button>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <!-- First passenger -->

                        <div class="card mb-3 passenger-card">

                            <div class="card-header">

                                <strong>
                                    Passenger 1
                                </strong>

                            </div>


                            <div class="card-body">

                                <div class="row">

                                    <div class="col-md-4">

                                        <label>
                                            Passenger Name
                                        </label>

                                        <input type="text"
                                               name="Passengers[0].PassengerName"
                                               class="form-control passenger-name"
                                               placeholder="Enter passenger name"
                                               required />

                                    </div>


                                    <div class="col-md-3">

                                        <label>
                                            Age
                                        </label>

                                        <input type="number"
                                               name="Passengers[0].PassengerAge"
                                               class="form-control passenger-age"
                                               min="1"
                                               max="120"
                                               placeholder="Age"
                                               required />

                                    </div>


                                    <div class="col-md-3">

                                        <label>
                                            Gender
                                        </label>

                                        <select name="Passengers[0].PassengerGender"
                                                class="form-control passenger-gender"
                                                required>

                                            <option value="">
                                                Select Gender
                                            </option>

                                            <option value="Male">
                                                Male
                                            </option>

                                            <option value="Female">
                                                Female
                                            </option>

                                            <option value="Other">
                                                Other
                                            </option>

                                        </select>

                                    </div>


                                    <div class="col-md-2">

                                        <label>
                                            &nbsp;
                                        </label>

                                        <button type="button"
                                                class="btn btn-danger form-control removePassenger">

                                            Remove

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>


                <!-- Add passenger -->

                <div class="mt-3">

                    <button type="button"
                            id="addPassenger"
                            class="btn btn-secondary">

                        + Add Passenger

                    </button>

                </div>


                <hr />


                <!-- Fare -->

                <div class="row">

                    <div class="col-md-6">

                        <h5>
                            Passengers:
                            <span id="passengerCount">
                                @(Model.Passengers == null
                                    ? 1
                                    : Model.Passengers.Count)
                            </span>
                        </h5>

                    </div>


                    <div class="col-md-6 text-right">

                        <h5>
                            Base Fare:
                            ₹ <span id="totalFare">
                                @(
                                    Model.Passengers == null
                                    ? Model.Price
                                    : Model.Price * Model.Passengers.Count
                                )
                            </span>
                        </h5>

                    </div>

                </div>


                <br />


                <!-- Continue -->

                <div class="text-right">

                    <button type="submit"
                            id="continueButton"
                            class="btn btn-primary btn-lg">

                        Continue to Seat Selection

                    </button>

                </div>

            }

        </div>

    </div>

</div>


<script>

    // ==========================================
    // VARIABLES
    // ==========================================

    const container =
        document.getElementById("passengerContainer");

    const addButton =
        document.getElementById("addPassenger");

    const form =
        document.getElementById("passengerForm");

    const passengerCount =
        document.getElementById("passengerCount");

    const totalFare =
        document.getElementById("totalFare");


    // Flight price coming from Razor

    const flightPrice =
        @Model.Price;


    // ==========================================
    // ADD PASSENGER
    // ==========================================

    addButton.addEventListener("click", function () {

        const cards =
            document.querySelectorAll(".passenger-card");

        const index =
            cards.length;


        const html = `

            <div class="card mb-3 passenger-card">

                <div class="card-header">

                    <strong>
                        Passenger ${index + 1}
                    </strong>

                </div>


                <div class="card-body">

                    <div class="row">

                        <!-- NAME -->

                        <div class="col-md-4">

                            <label>
                                Passenger Name
                            </label>

                            <input type="text"
                                   name="Passengers[${index}].PassengerName"
                                   class="form-control passenger-name"
                                   placeholder="Enter passenger name"
                                   required />

                        </div>


                        <!-- AGE -->

                        <div class="col-md-3">

                            <label>
                                Age
                            </label>

                            <input type="number"
                                   name="Passengers[${index}].PassengerAge"
                                   class="form-control passenger-age"
                                   min="1"
                                   max="120"
                                   placeholder="Age"
                                   required />

                        </div>


                        <!-- GENDER -->

                        <div class="col-md-3">

                            <label>
                                Gender
                            </label>

                            <select name="Passengers[${index}].PassengerGender"
                                    class="form-control passenger-gender"
                                    required>

                                <option value="">
                                    Select Gender
                                </option>

                                <option value="Male">
                                    Male
                                </option>

                                <option value="Female">
                                    Female
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                        </div>


                        <!-- REMOVE -->

                        <div class="col-md-2">

                            <label>
                                &nbsp;
                            </label>

                            <button type="button"
                                    class="btn btn-danger form-control removePassenger">

                                Remove

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        `;


        container.insertAdjacentHTML(
            "beforeend",
            html
        );


        updatePassengerNumbers();

        updateFare();

    });


    // ==========================================
    // REMOVE PASSENGER
    // ==========================================

    container.addEventListener(
        "click",
        function (event) {

            if (
                event.target.classList.contains(
                    "removePassenger"
                )
            ) {

                const cards =
                    document.querySelectorAll(
                        ".passenger-card"
                    );


                // Don't allow zero passengers

                if (cards.length <= 1) {

                    alert(
                        "At least one passenger is required."
                    );

                    return;
                }


                const card =
                    event.target.closest(
                        ".passenger-card"
                    );


                card.remove();


                updatePassengerNumbers();

                updateFare();

            }

        }
    );


    // ==========================================
    // UPDATE PASSENGER NUMBERS
    // ==========================================

    function updatePassengerNumbers() {

        const cards =
            document.querySelectorAll(
                ".passenger-card"
            );


        cards.forEach(
            function (card, index) {

                // Update heading

                const heading =
                    card.querySelector(
                        ".card-header strong"
                    );


                heading.textContent =
                    "Passenger " + (index + 1);


                // Update input/select names

                const fields =
                    card.querySelectorAll(
                        "input, select"
                    );


                fields.forEach(
                    function (field) {

                        const oldName =
                            field.getAttribute(
                                "name"
                            );


                        if (oldName) {

