using System;
using System.Collections.Generic;
using System.Data;
using System.Linq;
using System.Web.Mvc;

namespace Airlinemgmtsystem.Controllers
{
    public class BookingController : Controller
    {
        AirlineMgmtSystemEntities db = new AirlineMgmtSystemEntities();

        // Session keys
        private const string SESSION_FLIGHT_ID = "Booking_FlightID";
        private const string SESSION_PASSENGERS = "Booking_Passengers";
        private const string SESSION_SEAT_MAP = "Booking_SeatAssignments";
        private const string SESSION_FINAL_AMOUNT = "Booking_FinalAmount";

        // GET: /Booking/
        public ActionResult Index()
        {
            if (Session["UserID"] == null)
                return RedirectToAction("Login", "User");

            return View();
        }

        // GET: /Booking/PassengerDetails/5
        public ActionResult PassengerDetails(int id)
        {
            if (Session["UserID"] == null)
                return RedirectToAction("Login", "User");

            Flight flight = db.Flights.Find(id);

            if (flight == null)
                return HttpNotFound();

            if (flight.AvailableSeats <= 0)
            {
                TempData["Error"] = "No seats are available for this flight.";
                return RedirectToAction("Index");
            }

            ViewBag.Flight = flight;

            return View();
        }

        // POST: /Booking/PassengerDetails
        [HttpPost]
        public ActionResult PassengerDetails(int FlightID, List<Passenger> Passengers)
        {
            if (Session["UserID"] == null)
                return RedirectToAction("Login", "User");

            if (Passengers == null || Passengers.Count == 0)
            {
                TempData["Error"] = "Please enter passenger details.";
                return RedirectToAction("PassengerDetails", new { id = FlightID });
            }

            Flight flight = db.Flights.Find(FlightID);

            if (flight == null)
                return HttpNotFound();

            if (flight.AvailableSeats < Passengers.Count)
            {
                TempData["Error"] = "Not enough seats are available for this flight.";
                return RedirectToAction("PassengerDetails", new { id = FlightID });
            }

            // Store booking information temporarily in Session
            Session[SESSION_FLIGHT_ID] = FlightID;
            Session[SESSION_PASSENGERS] = Passengers;

            // Calculate fare on the server
            decimal finalAmount = flight.Price * Passengers.Count;
            Session[SESSION_FINAL_AMOUNT] = finalAmount;

            return RedirectToAction("SeatSelection");
        }

        // GET: /Booking/SeatSelection
        public ActionResult SeatSelection()
        {
            if (Session["UserID"] == null)
                return RedirectToAction("Login", "User");

            if (Session[SESSION_FLIGHT_ID] == null ||
                Session[SESSION_PASSENGERS] == null)
            {
                return RedirectToAction("Index");
            }

            int flightId = Convert.ToInt32(Session[SESSION_FLIGHT_ID]);

            Flight flight = db.Flights.Find(flightId);

            if (flight == null)
                return HttpNotFound();

            var passengers = Session[SESSION_PASSENGERS] as List<Passenger>;

            if (passengers == null || passengers.Count == 0)
                return RedirectToAction("Index");

            ViewBag.Flight = flight;
            ViewBag.BaseFare = Session[SESSION_FINAL_AMOUNT];
            ViewBag.Passengers = passengers;

            ViewBag.Seats = db.FlightSeats
                .Where(x => x.FlightID == flightId)
                .OrderBy(x => x.SeatNumber)
                .ToList();

            return View();
        }

        // POST: /Booking/SeatSelection
        [HttpPost]
        public ActionResult SeatSelection(int[] passengerIndex, int[] seatId)
        {
            if (Session["UserID"] == null)
                return RedirectToAction("Login", "User");

            if (Session[SESSION_FLIGHT_ID] == null ||
                Session[SESSION_PASSENGERS] == null)
            {
                return RedirectToAction("Index");
            }

            var passengers = Session[SESSION_PASSENGERS] as List<Passenger>;

            if (passengers == null || passengers.Count == 0)
                return RedirectToAction("Index");

            if (passengerIndex == null || seatId == null ||
                passengerIndex.Length != seatId.Length)
            {
                TempData["Error"] = "Please select a seat for every passenger.";
                return RedirectToAction("SeatSelection");
            }

            if (seatId.Length != passengers.Count)
            {
                TempData["Error"] = "Please select one seat for every passenger.";
                return RedirectToAction("SeatSelection");
            }

            // Prevent duplicate seat selection
            if (seatId.Distinct().Count() != seatId.Length)
            {
                TempData["Error"] = "The same seat cannot be selected for multiple passengers.";
                return RedirectToAction("SeatSelection");
            }

            // Validate passenger indexes
            if (passengerIndex.Any(x => x < 0 || x >= passengers.Count))
            {
                TempData["Error"] = "Invalid passenger selection.";
                return RedirectToAction("SeatSelection");
            }

            // Make sure every passenger appears exactly once
            if (passengerIndex.Distinct().Count() != passengers.Count)
            {
                TempData["Error"] = "Please select seats for all passengers.";
                return RedirectToAction("SeatSelection");
            }

            int flightId = Convert.ToInt32(Session[SESSION_FLIGHT_ID]);

            Flight flight = db.Flights.Find(flightId);

            if (flight == null)
                return HttpNotFound();

            // Verify selected seats belong to this flight
            var selectedSeatIds = seatId.ToList();

            var validSeats = db.FlightSeats
                .Where(x => x.FlightID == flightId &&
                            selectedSeatIds.Contains(x.SeatID))
                .ToList();

            if (validSeats.Count != seatId.Length)
            {
                TempData["Error"] = "One or more selected seats are invalid.";
                return RedirectToAction("SeatSelection");
            }

            // Check whether any selected seat is already booked
            if (validSeats.Any(x => x.IsBooked))
            {
                TempData["Error"] = "One or more selected seats have already been booked. Please select different seats.";
                return RedirectToAction("SeatSelection");
            }

            // Create passengerIndex -> SeatID mapping
            var seatMap = new Dictionary<int, int>();

            for (int i = 0; i < passengerIndex.Length; i++)
            {
                seatMap[passengerIndex[i]] = seatId[i];
            }

            Session[SESSION_SEAT_MAP] = seatMap;

            // Recalculate fare on server
            decimal finalAmount = flight.Price * passengers.Count;
            Session[SESSION_FINAL_AMOUNT] = finalAmount;

            return RedirectToAction("Payment");
        }

        // GET: /Booking/Payment
        public ActionResult Payment()
        {
            if (Session["UserID"] == null)
                return RedirectToAction("Login", "User");

            if (Session[SESSION_FLIGHT_ID] == null ||
                Session[SESSION_PASSENGERS] == null ||
                Session[SESSION_SEAT_MAP] == null)
            {
                return RedirectToAction("Index");
            }

            int flightId = Convert.ToInt32(Session[SESSION_FLIGHT_ID]);

            Flight flight = db.Flights.Find(flightId);

            if (flight == null)
                return HttpNotFound();

            var passengers = Session[SESSION_PASSENGERS] as List<Passenger>;

            if (passengers == null || passengers.Count == 0)
                return RedirectToAction("Index");

            // Calculate amount again from database
            decimal finalAmount = flight.Price * passengers.Count;

            Session[SESSION_FINAL_AMOUNT] = finalAmount;

            ViewBag.Flight = flight;
            ViewBag.FinalAmount = finalAmount;
            ViewBag.Passengers = passengers;

            return View();
        }

        // POST: /Booking/Payment
        [HttpPost]
        public ActionResult Payment(string paymentMethod)
        {
            if (Session["UserID"] == null)
                return RedirectToAction("Login", "User");

            if (Session[SESSION_FLIGHT_ID] == null ||
                Session[SESSION_PASSENGERS] == null ||
                Session[SESSION_SEAT_MAP] == null)
            {
                return RedirectToAction("Index");
            }

            if (string.IsNullOrWhiteSpace(paymentMethod))
            {
                TempData["Error"] = "Please select a payment method.";
                return RedirectToAction("Payment");
            }

            int userId = Convert.ToInt32(Session["UserID"]);
            int flightId = Convert.ToInt32(Session[SESSION_FLIGHT_ID]);

            var passengers = Session[SESSION_PASSENGERS] as List<Passenger>;
            var seatMap = Session[SESSION_SEAT_MAP] as Dictionary<int, int>;

            if (passengers == null || passengers.Count == 0 ||
                seatMap == null || seatMap.Count != passengers.Count)
            {
                return RedirectToAction("Index");
            }

            using (var transaction = db.Database.BeginTransaction(IsolationLevel.Serializable))
            {
                try
                {
                    // Get flight from database
                    Flight flight = db.Flights.Find(flightId);

                    if (flight == null)
                    {
                        transaction.Rollback();
                        return HttpNotFound();
                    }

                    // Check available seats again
                    if (flight.AvailableSeats < passengers.Count)
                    {
                        transaction.Rollback();

                        TempData["Error"] = "Not enough seats are available for this flight.";
                        return RedirectToAction("SeatSelection");
                    }

                    // Calculate final amount on server
                    decimal finalAmount = flight.Price * passengers.Count;

                    // -------------------------------------------------
                    // 1. CREATE BOOKING
                    // -------------------------------------------------
                    Booking booking = new Booking
                    {
                        UserID = userId,
                        FlightID = flightId,
                        BookingDate = DateTime.Now,
                        TotalAmount = finalAmount,
                        BookingStatus = "Confirmed"
                    };

                    db.Bookings.Add(booking);
                    db.SaveChanges();

                    // -------------------------------------------------
                    // 2. ADD PASSENGERS
                    // -------------------------------------------------
                    foreach (Passenger passenger in passengers)
                    {
                        passenger.BookingID = booking.BookingID;
                        passenger.FlightSeatID = null;

                        db.Passengers.Add(passenger);
                    }

                    db.SaveChanges();

                    // -------------------------------------------------
                    // 3. ASSIGN SEATS
                    // -------------------------------------------------
                    for (int i = 0; i < passengers.Count; i++)
                    {
                        Passenger passenger = passengers[i];

                        int seatId;
                        if (!seatMap.TryGetValue(i, out seatId))
                        {
                            throw new Exception("Seat assignment missing for passenger.");
                        }

                        FlightSeat seat = db.FlightSeats
                            .FirstOrDefault(x =>
                                x.SeatID == seatId &&
                                x.FlightID == flightId);

                        if (seat == null)
                        {
                            throw new Exception("Selected seat does not belong to this flight.");
                        }

                        if (seat.IsBooked)
                        {
                            throw new Exception("One of the selected seats has already been booked.");
                        }

                        seat.IsBooked = true;
                        seat.PassengerID = passenger.PassengerID;

                        passenger.FlightSeatID = seat.SeatID;
                    }

                    db.SaveChanges();

                    // -------------------------------------------------
                    // 4. DECREASE AVAILABLE SEATS
                    // -------------------------------------------------
                    flight.AvailableSeats -= passengers.Count;

                    if (flight.AvailableSeats < 0)
                        throw new Exception("Invalid available seat count.");

                    db.SaveChanges();

                    // -------------------------------------------------
                    // 5. CREATE PAYMENT
                    // -------------------------------------------------
                    Payment payment = new Payment
                    {
                        BookingID = booking.BookingID,
                        PaymentMethod = paymentMethod,
                        Amount = finalAmount,
                        PaymentStatus = "Success",
                        PaymentDate = DateTime.Now,
                        TransactionID =
                            "TXN" +
                            DateTime.Now.ToString("yyyyMMddHHmmss") +
                            Guid.NewGuid().ToString("N").Substring(0, 8).ToUpper()
                    };

                    db.Payments.Add(payment);

                    db.SaveChanges();

                    // -------------------------------------------------
                    // 6. COMMIT EVERYTHING
                    // -------------------------------------------------
                    transaction.Commit();

                    // -------------------------------------------------
                    // 7. CLEAR BOOKING SESSION
                    // -------------------------------------------------
                    Session.Remove(SESSION_FLIGHT_ID);
                    Session.Remove(SESSION_PASSENGERS);
                    Session.Remove(SESSION_SEAT_MAP);
                    Session.Remove(SESSION_FINAL_AMOUNT);

                    return RedirectToAction(
                        "BookingSummary",
                        new { bookingId = booking.BookingID }
                    );
                }
                catch (Exception)
                {
                    transaction.Rollback();

                    TempData["Error"] =
                        "Something went wrong while confirming your booking. Please try again.";

                    return RedirectToAction("Payment");
                }
            }
        }

        // GET: /Booking/BookingSummary/5
        public ActionResult BookingSummary(int bookingId)
        {
            if (Session["UserID"] == null)
                return RedirectToAction("Login", "User");

            int userId = Convert.ToInt32(Session["UserID"]);

            // IMPORTANT:
            // Only allow the logged-in user to view their own booking
            Booking booking = db.Bookings
                .FirstOrDefault(x =>
                    x.BookingID == bookingId &&
                    x.UserID == userId);

            if (booking == null)
                return HttpNotFound();

            Flight flight = db.Flights.Find(booking.FlightID);

            Payment payment = db.Payments
                .FirstOrDefault(x => x.BookingID == bookingId);

            var passengers = db.Passengers
                .Where(x => x.BookingID == bookingId)
                .ToList();

            ViewBag.Booking = booking;
            ViewBag.Flight = flight;
            ViewBag.Payment = payment;
            ViewBag.Passengers = passengers;

            return View();
        }

        protected override void Dispose(bool disposing)
        {
            if (disposing)
            {
                db.Dispose();
            }

            base.Dispose(disposing);
        }
    }
}
