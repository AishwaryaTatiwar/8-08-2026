.<a href="javascript:void(0)"
   class="btn btn-warning btn-sm edit-user-btn"
   data-id="@item.UserID">
    <i class="bi bi-pencil-square"></i>
</a>

$(document).on("click", ".edit-user-btn", function () {

    var id = $(this).data("id");

    $.ajax({
        url: '@Url.Action("EditUser", "Admin")',
        type: 'GET',
        data: { id: id },

        success: function (data) {

            $("#editUserModal .modal-body").html(data);

            var modal = new bootstrap.Modal(
                document.getElementById("editUserModal")
            );

            modal.show();
        },

        error: function (xhr) {
            console.log(xhr.responseText);
        }
    });
});
@model Airlinemgmtsystem.User

@{
    Layout = null;
}

<form method="post" action="@Url.Action("EditUser", "Admin")">

    @Html.AntiForgeryToken()

    <input type="hidden" id="editUserId" name="UserID" value="@Model.UserID" />

    <div class="mb-3">
        <label class="form-label">Username</label>

        <input type="text"
               id="editUsername"
               class="form-control"
               value="@Model.Username"
               readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">Role</label>

        <select name="Role"
                id="editRole"
                class="form-control"
                required>

            <option value="User" @(Model.Role == "User" ? "selected" : "")>
                Customer
            </option>

            <option value="Admin" @(Model.Role == "Admin" ? "selected" : "")>
                Admin
            </option>

        </select>
    </div>

    <div class="modal-footer px-0 pb-0">

        <button type="button"
                class="btn btn-secondary"
                data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit"
                class="btn btn-primary">
            Save Changes
        </button>

    </div>

</form>
